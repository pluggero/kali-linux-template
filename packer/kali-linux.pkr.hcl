##################################################################################
# BUILDS
##################################################################################

# Build 1: Base image (no guest utilities)
build {
  name = "base"

  sources = [
    "source.qemu.kali-linux-base"
  ]

  provisioner "breakpoint" {
    disable = true
    note    = "Breakpoint before ansible run"
  }

  provisioner "ansible" {
    collections_path = "${path.root}/${var.ansible_collections_path}"
    roles_path       = "${path.root}/${var.ansible_roles_path}"
    playbook_file    = "${path.root}/${var.ansible_playbook_init}"
    user             = "${var.vm_ssh_username}"
    ansible_env_vars = [
      "ANSIBLE_ROLES_PATH=${path.root}/${var.ansible_roles_path}",
      "ANSIBLE_VAULT_PASSWORD_FILE=${path.root}/${var.ansible_vault_password_file}",
      "ANSIBLE_FORCE_COLOR=true",
      "ANSIBLE_HOST_KEY_CHECKING=false",
    ]
    extra_arguments = [
      "--extra-vars",
      "ansible_become_password=${var.vm_ssh_temp_password}",
    ]
  }

  provisioner "ansible" {
    collections_path = "${path.root}/${var.ansible_collections_path}"
    roles_path       = "${path.root}/${var.ansible_roles_path}"
    playbook_file    = "${path.root}/${var.ansible_playbook_base}"
    user             = "${var.vm_ssh_username}"
    ansible_env_vars = [
      "ANSIBLE_ROLES_PATH=${path.root}/${var.ansible_roles_path}",
      "ANSIBLE_VAULT_PASSWORD_FILE=${path.root}/${var.ansible_vault_password_file}",
      "ANSIBLE_FORCE_COLOR=true",
      "ANSIBLE_HOST_KEY_CHECKING=false",
    ]
    extra_arguments = [
      "--extra-vars",
      "ansible_become_password=${var.vm_ssh_password} ansible_remote_tmp=/tmp ",
    ]
  }

  provisioner "breakpoint" {
    disable = true
    note    = "Breakpoint after ansible run"
  }

  # Post-processor: Generate checksum file for downstream builds
  # This checksum is referenced by sources 2-4 (QEMU, VirtualBox, VMware)
  post-processor "shell-local" {
    inline = [
      "set -e",
      "cd ${local.base_packer_output}",
      "sha256sum ${local.vm_name}.qcow2 > ${local.vm_name}.qcow2.sha256",
      "test -f ${local.vm_name}.qcow2.sha256 || exit 1",
      "echo 'Generated checksum file: ${local.vm_name}.qcow2.sha256'",
      "cat ${local.vm_name}.qcow2.sha256"
    ]
  }

}

