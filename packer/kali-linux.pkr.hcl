##################################################################################
# SOURCES
##################################################################################

# Source 1: Base image (boots from ISO)
source "qemu" "kali-linux-base" {
  vm_name          = "${local.vm_name}.qcow2"
  iso_url          = local.kali_iso_url_x86_64
  iso_checksum     = local.kali_iso_checksum_x86_64
  iso_target_path  = "${path.root}/${var.packer_input_dir}/${local.kali_iso_name_x86_64}"
  http_directory   = local.http_directory
  http_interface   = var.http_interface
  shutdown_command = local.vm_nonroot_shutdown_command
  ssh_username     = var.vm_ssh_username
  ssh_password     = var.vm_ssh_temp_password
  ssh_timeout      = var.vm_ssh_timeout
  ssh_port         = var.vm_ssh_port
  boot_command     = local.debian_boot_command_x86_64
  boot_wait        = var.vm_boot_wait
  disk_size        = "${var.vm_disk_size}M"
  disk_interface   = var.qemu_disk_interface
  net_device       = var.qemu_net_device
  format           = var.qemu_format
  accelerator      = var.qemu_accelerator
  machine_type     = var.qemu_machine_type
  cpus             = var.vm_cpu_core
  memory           = var.vm_mem_size
  display          = var.qemu_display
  headless         = var.qemu_headless
  output_directory = "${local.base_packer_output}"
  qemuargs = [
    ["-bios", "/usr/share/edk2-ovmf/x64/OVMF.4m.fd"]
  ]
}

# Source 2: QEMU build (boots from base qcow2)
source "qemu" "kali-linux-qemu" {
  vm_name          = "${local.vm_name}.qcow2"
  disk_image       = true
  iso_url          = "${local.base_packer_output}/${local.vm_name}.qcow2"
  # Checksum file is auto-generated by base build post-processor
  iso_checksum     = "file:${local.base_packer_output}/${local.vm_name}.qcow2.sha256"
  shutdown_command = local.vm_nonroot_shutdown_command
  ssh_username     = var.vm_ssh_username
  ssh_password     = var.vm_ssh_password
  ssh_timeout      = var.vm_ssh_timeout
  ssh_port         = var.vm_ssh_port
  boot_wait        = "5s"
  disk_size        = "${var.vm_disk_size}M"
  disk_interface   = var.qemu_disk_interface
  net_device       = var.qemu_net_device
  format           = var.qemu_format
  accelerator      = var.qemu_accelerator
  machine_type     = var.qemu_machine_type
  cpus             = var.vm_cpu_core
  memory           = var.vm_mem_size
  display          = var.qemu_display
  headless         = var.qemu_headless
  output_directory = "${local.qemu_packer_output}"
  qemuargs = [
    ["-bios", "/usr/share/edk2-ovmf/x64/OVMF.4m.fd"]
  ]
}

